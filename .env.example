# ==============================================================================
# Regulated Agent Harness Environment Configuration
# ==============================================================================

ENVIRONMENT=development

# Primary & Fallback LLM Providers (LiteLLM format)
PRIMARY_MODEL=azure/gpt-4o
FALLBACK_MODELS=bedrock/anthropic.claude-3-5-sonnet

# Azure OpenAI (Optional)
AZURE_API_KEY=
AZURE_API_BASE=
AZURE_API_VERSION=2024-02-15-preview

# Anthropic (Optional)
ANTHROPIC_API_KEY=

# AWS Bedrock (Optional)
AWS_REGION_NAME=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Local vLLM / Ollama (Optional)
OLLAMA_API_BASE=http://localhost:11434

# Checkpointing & Persistence (sqlite or postgres)
CHECKPOINTER_TYPE=sqlite
DATABASE_URL=sqlite+aiosqlite:///./.harness_checkpoints.db

# Observability & Langfuse
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Governance & Safeguards
MAX_SESSION_COST_USD=0.50
MAX_ITERATIONS=10
REDACT_PII=true
